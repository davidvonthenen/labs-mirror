# Copy this file to .env and fill in real values. .env is gitignored.

# --- Instaclustr OpenSearch ---
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_SSL=true

# Per-task index names -- change these if you share a cluster with others
# Baseline Vector RAG and Baseline BM25 RAG (baseline vector/BM25 indexes over the recipe dataset)
OPENSEARCH_HYBRID_INDEX="ragretrieval-recipes-hybrid"
OPENSEARCH_RECIPE_BM25_INDEX="ragretrieval-recipes-bm25"
OPENSEARCH_RECIPE_VECTOR_INDEX="ragretrieval-recipes-vector"
# (e.g. append your name/initials so you don't collide with other users of the cluster).
OPENSEARCH_VECTOR_RECIPES_BASELINE_INDEX="ragretrieval-recipes-vector-baseline"
OPENSEARCH_BM25_RECIPES_BASELINE_INDEX="ragretrieval-recipes-bm25-baseline"
# Governance Tiering (governance audit trail + hot/LT tiering thresholds)
OPENSEARCH_AUDIT_INDEX="ragretrieval-recipes-audit-log"

# --- LLM provider selection ---
# "openai" (default), "anthropic", or "bedrock". Every task calls generate().
# Configure the credentials and model for the provider selected below.
LLM_PROVIDER=openai

# --- Amazon Bedrock (optional; used only when LLM_PROVIDER=bedrock) ---
# Uses the Anthropic SDK on Bedrock. AWS settings are not required for the
# OpenAI or direct Anthropic providers. AWS profiles/roles are supported when
# available inside the selected runtime.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional named profile or temporary-session token:
# AWS_PROFILE=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Exact model ID from your account's Bedrock Model access page. Some newer models
# need an inference profile ID instead (see the Bedrock console, Cross-region inference).
BEDROCK_MODEL_ID=

# --- OpenAI / OpenAI-compatible (used when LLM_PROVIDER=openai) ---
# OPENAI_BASE_URL also accepts any OpenAI-compatible endpoint, not just
# OpenAI itself (e.g. a self-hosted or alternate provider's /v1 URL).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL="gpt-6-luna"

# --- Direct Anthropic API (used only when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Exact Claude model ID enabled for your Anthropic account.
ANTHROPIC_MODEL="claude-haiku-5-5"

# --- HuggingFace (optional: higher rate limits when downloading the embedding model) ---
HF_TOKEN=

# --- Embeddings / NER (defaults are fine for most machines) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
NER_SERVICE_URL=http://127.0.0.1:8000/ner
