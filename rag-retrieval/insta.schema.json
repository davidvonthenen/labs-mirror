{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "config": {
      "type": "object",
      "patternProperties": {
        "^[A-Z][A-Z0-9_]*$": {
          "$ref": "#/$defs/config"
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/platform"
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/service"
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/task"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "instructions",
    "runtime",
    "config",
    "platforms",
    "tasks",
    "lifecycle"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "insta lab manifest v1",
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "number"
          ]
        },
        "default": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "python"
        },
        "python": {
          "const": "3.12"
        },
        "requirements": {
          "type": "string"
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "required": [
        "kind",
        "python",
        "requirements"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "instaclustr-opensearch",
            "instaclustr-kafka",
            "instaclustr-cassandra",
            "instaclustr-clickhouse"
          ]
        },
        "request": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "request"
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "conditional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "when": {
          "type": "object",
          "patternProperties": {
            "^[A-Z][A-Z0-9_]*$": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "required": [
        "operations",
        "when",
        "required"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditional"
          }
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "default": {
          "type": "string"
        }
      },
      "required": [
        "config"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "oneshot",
            "interactive"
          ]
        },
        "cwd": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "verification": {
          "type": "string"
        }
      },
      "required": [
        "command"
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "body": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 100,
              "maximum": 599
            }
          ]
        }
      },
      "required": [
        "url"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "probe": {
          "$ref": "#/$defs/probe"
        }
      },
      "required": [
        "cwd",
        "command",
        "probe"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blueprint": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "operations": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "$ref": "#/$defs/operation"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "blueprint",
        "source",
        "operations"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "action": {
          "enum": [
            "ensure",
            "destroy_owned",
            "start",
            "stop"
          ]
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": [
            "platform"
          ],
          "not": {
            "required": [
              "service"
            ]
          },
          "properties": {
            "action": {
              "enum": [
                "ensure",
                "destroy_owned"
              ]
            }
          }
        },
        {
          "required": [
            "service"
          ],
          "not": {
            "required": [
              "platform"
            ]
          },
          "properties": {
            "action": {
              "enum": [
                "start",
                "stop"
              ]
            }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "up": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "down": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "required": [
        "up",
        "down"
      ]
    }
  }
}
